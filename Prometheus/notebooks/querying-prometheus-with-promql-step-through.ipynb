    "---\n\n",
    "# Querying Prometheus with PromQL — step-through\n\n",
    "A walk through the PromQL query language against the Prometheus HTTP API: instant queries, range queries, functions, operators, and the recording and alerting rules that consume the results."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json, urllib.parse, urllib.request\n\n",
    "PROM = \"http://localhost:9090\"\n\n",
    "def q(expr):\n",
    "    url = f\"{PROM}/api/v1/query?query={urllib.parse.quote(expr)}\"\n",
    "    with urllib.request.urlopen(url, timeout=10) as r:\n",
    "        return json.load(r)\n\n",
    "print(json.dumps(q(\"up\"), indent=2)[:400])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Range query: per-second rate of http_requests_total over 5m buckets\n",
    "url = f\"{PROM}/api/v1/query_range?query=rate(http_requests_total[5m])&start=now-1h&end=now&step=60\"\n",
    "with urllib.request.urlopen(url, timeout=10) as r:\n",
    "    data = json.load(r)\n",
    "print(len(data['data']['result']), \"series returned\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Aggregation: sum by job, averaged over the last hour\n",
    "expr = \"avg_over_time(http_request_duration_seconds_bucket[1h])\"\n",
    "print(q(expr)['data']['result'][0]['metric'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Alerting rule check: is the high-error-rate rule firing?\n",
    "print(q(\"ALERTS_FOR_STATE\").get('data', {}).get('resultCount', 'n/a'))"
   ]
  }
 ]
}
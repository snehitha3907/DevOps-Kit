# last_verified: 2026-10-19 · Docker Compose (n/a)
# Environment variable template for the Prometheus + Alertmanager + Grafana stack.
# Copy to .env and customize values before starting the stack.
# 
# For production deployments, pin all images to specific versions (e.g., prom/prometheus:v2.54.1)
# instead of major-version tags to ensure reproducible builds.

# Image tags (major-version tags used as defaults; override with specific versions for production)
PROMETHEUS_IMAGE=prom/prometheus:v2
ALERTMANAGER_IMAGE=prom/alertmanager:v0
GRAFANA_IMAGE=grafana/grafana:11
NODE_EXPORTER_IMAGE=prom/node-exporter:v1

# Host port mappings (change if ports are in use)
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
NODE_EXPORTER_PORT=9100

# Prometheus retention settings
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB

# Grafana admin credentials (CHANGE THESE IN PRODUCTION)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Alertmanager notification webhooks (configure for your environment)
# Default webhook receiver (all alerts)
ALERTMANAGER_WEBHOOK_URL=http://localhost:5001/webhook

# Critical severity webhook (alerts with severity=critical)
ALERTMANAGER_CRITICAL_WEBHOOK_URL=http://localhost:5002/critical

# Warning severity webhook (alerts with severity=warning)
ALERTMANAGER_WARNING_WEBHOOK_URL=http://localhost:5003/warning

# Email configuration (requires SMTP server)
SMTP_SMARTHOST=localhost:25
SMTP_FROM=alertmanager@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=oncall@example.com

# Environment label applied to all metrics
ENVIRONMENT=development
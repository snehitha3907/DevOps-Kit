# last_verified: 2026-09-16 · Ansible 14.4.0
# Per-site virtual host. Rendered into sites-available/<server_name>.conf.

server {
    listen {{ webserver_listen_port }};
    server_name {{ webserver_server_name }};

    root {{ webserver_document_root }};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }

    location /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}